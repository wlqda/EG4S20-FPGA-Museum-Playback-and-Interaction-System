create_clock -name SYS_CLK -period 20 [get_ports {sys_clk}]
create_generated_clock -name SERIAL_CLK -source [get_ports {sys_clk}] -multiply_by 2.5 [get_nets {gallery/serial_clk}]
create_generated_clock -name PIXEL_CLK -source [get_ports {sys_clk}] -divide_by 2 [get_nets {gallery/pixel_clk}]
create_generated_clock -name MEMORY_CLK -source [get_ports {sys_clk}] -multiply_by 2 [get_nets {gallery/mem_clk}]
create_generated_clock -name SDRAM_CLK -source [get_ports {sys_clk}] -edges {1 2 3} -edge_shift {7.25 2.25 -2.75} [get_nets {gallery/sdram_clk}]
# Preserve the verified Gallery SDRAM capture latency.
set_multicycle_path 2 -setup -from [get_clocks {SDRAM_CLK}] -to [get_clocks {MEMORY_CLK}]
set_multicycle_path 1 -hold -from [get_clocks {SDRAM_CLK}] -to [get_clocks {MEMORY_CLK}]
create_generated_clock -name CAMERA_CLK -source [get_ports {sys_clk}] -divide_by 1 [get_nets {engine/camera_clk}]
create_clock -name DVP_CLK -period 40 [get_ports {CAM_PCLK}]
create_generated_clock -name CAPTURE_CLK -source [get_ports {CAM_PCLK}] -divide_by 1 [get_nets {engine/pclk}]
set_input_delay -clock DVP_CLK -clock_fall -max 10 [get_ports {CAM_D[*] CAM_VSYNC CAM_HREF}]
set_input_delay -clock DVP_CLK -clock_fall -min -2 [get_ports {CAM_D[*] CAM_VSYNC CAM_HREF}]
set_false_path -from [get_ports {CAM_SCL CAM_SDA}] -to [get_regs {engine/bus/scl_sync* engine/bus/sda_sync*}]
set_false_path -from [get_regs {engine/reset_pipe* engine/config_control/ready*}] -to [get_regs {engine/pclk_reset_pipe* engine/pixel_reset_pipe*}]
set_false_path -from [get_ports {KEY2_N}] -to [get_regs {engine/background_button/key_sync*}]
set_false_path -from [get_ports {KEY3_N}] -to [get_regs {engine/capture_button/key_sync*}]
set_false_path -from [get_ports {KEY4_N}] -to [get_regs {engine/view_button/key_sync*}]
set_max_delay 40 -datapath_only -from [get_regs {engine/source_stream/fifo/rd_gray*}] -to [get_regs {engine/source_stream/fifo/rd_sync1*}]
set_max_delay 40 -datapath_only -from [get_regs {engine/source_stream/fifo/wr_gray*}] -to [get_regs {engine/source_stream/fifo/wr_sync1*}]
set_min_delay 0 -from [get_regs {engine/source_stream/fifo/rd_gray*}] -to [get_regs {engine/source_stream/fifo/rd_sync1*}]
set_min_delay 0 -from [get_regs {engine/source_stream/fifo/wr_gray*}] -to [get_regs {engine/source_stream/fifo/wr_sync1*}]
set_false_path -from [get_regs {engine/source_stream/write_fault*}] -to [get_regs {engine/source_stream/fault_sync*}]
set_output_delay -clock SYS_CLK -max 0 [get_ports {CAM_SCL CAM_SDA CAM_PWDN CAM_RESET_N}]
set_output_delay -clock SYS_CLK -min 0 [get_ports {CAM_SCL CAM_SDA CAM_PWDN CAM_RESET_N}]
# UART_TX is registered on the 25MHz pixel clock by camera_telemetry_uart, so it
# belongs to the PIXEL_CLK group rather than SYS_CLK. It previously sat in the
# SYS_CLK group only because it was a tie-off constant.
set_output_delay -clock PIXEL_CLK -max 0 [get_ports {UART_TX LED[*] HDMI_DDC_SCL HDMI_DDC_SDA}]
set_output_delay -clock PIXEL_CLK -min 0 [get_ports {UART_TX LED[*] HDMI_DDC_SCL HDMI_DDC_SDA}]

set_false_path -from [get_ports {KEY2_N KEY3_N KEY4_N}] -to [get_regs {key_modes/sync1*}]
set_false_path -from [get_ports {SW1}] -to [get_regs {clock_switch/sync*}]
set_false_path -from [get_ports {SW2}] -to [get_regs {preview_switch/sync*}]
set_false_path -from [get_ports {SW3}] -to [get_regs {gesture_switch/sync*}]
